# Copy this file to deploy.env on the Linux server and edit values if needed.

DEPLOY_ROOT=/data/zhangxu
REPOS_DIR=/data/zhangxu/repos
WWW_DIR=/data/zhangxu/www
LOG_DIR=/data/zhangxu/logs
# Bare host only. Do not include protocol, port, or path.
# deploy-all.sh injects this as VITE_INTEGRATION_HOST for /integration iframe URLs.
PUBLIC_HOST=10.184.17.176
PROJECT5_FRONTEND_ROOT=/data/zhangxu/www/project5
PROJECT5_NGINX_SITE_NAME=llmsafe-project5
# Confirm→detect background worker (python -m app.workers.governance_task_worker).
# Default on: deploy-all enables and restarts it with Project 5 backend.
# Set false/0/off to stop only this worker; governance API/session still work,
# but confirmed rescan tasks stay queued until a worker is running again.
PROJECT5_GOVERNANCE_WORKER_ENABLED=true

# Deployment orchestration. Defaults reproduce the historical behaviour: deploy
# every component, abort on the first failure, execute for real.
# DEPLOY_COMPONENTS: "all" or a comma separated subset, e.g.
#   "project5,topic3-benchmark" (handy to re-run one component after a failure).
# DEPLOY_STRICT=false keeps deploying after a failing component and reports the
#   failures at the end; use it on a host where optional integration repos,
#   datasets or secrets are not available yet.
# DEPLOY_DRY_RUN=true prints every mutating command (sudo/systemctl/git/pip/
#   build) without executing it. Pair it with --dump-config to diff a host
#   before/after a deploy-script change.
DEPLOY_COMPONENTS=all
DEPLOY_STRICT=true
DEPLOY_DRY_RUN=false
# Every Topic repo is cloned from this GitHub org. Override only if the repos
# move; individual *_REPO_URL values still win.
# GITHUB_ORG=NGAI-LLMSafeContent

CONDA_ENV=llmsafe-py310
# Leave empty to resolve conda from PATH. Set explicitly if systemd cannot find it.
CONDA_BIN=
# Topic 3 dynamic difficulty uses an isolated Python 3.12 conda env because
# vLLM is a heavy CUDA/Torch dependency and should not share Project 5's py310 env.
TOPIC3_DIFFICULTY_CONDA_ENV=llmsafe-topic3-difficulty-py312
TOPIC3_DIFFICULTY_PYTHON=3.12
TOPIC3_DIFFICULTY_HF_HOME=/data/zhangxu/cache/huggingface
# Risk Agent is CPU-only; it calls the difficulty Qwen router, not a second vLLM.
TOPIC3_RISK_CONDA_ENV=llmsafe-topic3-risk-py310

PROJECT5_REPO_NAME=Project_5_LLM_Content_Safety_Governance_Web
TOPIC1_REPO_NAME=Project_1_Construction_of_Evaluation_System
TOPIC1_VALUE_QA_REPO_NAME=Project_1_Sample_evaluation_Generation
TOPIC2_FLYWHEEL_REPO_NAME=Project_2_Flywheel_on_Anomaly_Detection_Tracking_Correction
TOPIC2_FILTERGUARD_REPO_NAME=Project_2_Anomaly_Data_Identification
TOPIC3_BENCHMARK_REPO_NAME=Project_3_Risk_Hierarchical_Classification_Benchmark
TOPIC3_COMPLIANCE_REPO_NAME=Project_3_Compliance_Editing_Tool
TOPIC3_COMPLIANCE_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Compliance_Editing_Tool.git
TOPIC3_CULTURAL_GEN_REPO_NAME=Project_3_Cultural_Generation_Tool
TOPIC3_CULTURAL_CORPUS_REPO_NAME=Project_3_Cultural_Diversity_Corpus_Generation_Tool
TOPIC3_CULTURAL_ASSESSMENT_REPO_NAME=Project_3_Cultural_Diversity_Assessment_Tool
TOPIC3_DIFFICULTY_REPO_NAME=Project_3_Dynamic_Difficulty_Question_Generation_Tool
TOPIC3_RISK_REPO_NAME=Project_3_Dynamic_Risk_Benchmark_Generation

PROJECT5_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_5_LLM_Content_Safety_Governance_Web.git
TOPIC1_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_1_Construction_of_Evaluation_System.git
TOPIC1_VALUE_QA_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_1_Sample_evaluation_Generation.git
TOPIC2_FLYWHEEL_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_2_Flywheel_on_Anomaly_Detection_Tracking_Correction.git
TOPIC2_FILTERGUARD_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_2_Anomaly_Data_Identification.git
TOPIC3_BENCHMARK_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Risk_Hierarchical_Classification_Benchmark.git
TOPIC3_CULTURAL_GEN_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Cultural_Generation_Tool.git
TOPIC3_CULTURAL_CORPUS_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Cultural_Diversity_Corpus_Generation_Tool.git
TOPIC3_CULTURAL_ASSESSMENT_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Cultural_Diversity_Assessment_Tool.git
TOPIC3_DIFFICULTY_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Dynamic_Difficulty_Question_Generation_Tool.git
# Topic 3 dynamic risk is a local snapshot only. deploy-all.sh never clones or
# pulls this tree from GitHub; sync it under REPOS_DIR manually when needed.
# TOPIC3_RISK_REPO_URL is unused by deploy (kept here as a documentation hint only).
# TOPIC3_RISK_REPO_URL=git@github.com:NGAI-LLMSafeContent/Project_3_Dynamic_Risk_Benchmark_Generation.git

PROJECT5_FRONTEND_PORT=5173
PROJECT5_BACKEND_PORT=5800
TOPIC3_BENCHMARK_PORT=6006
TOPIC3_COMPLIANCE_PORT=6311
TOPIC3_DIVERSITY_UI_PORT=6321
TOPIC3_DIVERSITY_API_PORT=6322
TOPIC3_DIVERSITY_DATA_PORT=6323
TOPIC3_CULTURAL_ASSESSMENT_CONSOLE_PORT=8877
TOPIC3_CULTURAL_ASSESSMENT_CONSOLE_V2_PORT=8878
TOPIC3_DIFFICULTY_PORT=6331
TOPIC3_DIFFICULTY_ROUTER_PORT=6332
TOPIC3_DIFFICULTY_GENERATION_WORKER_PORT=6333
TOPIC3_DIFFICULTY_GUARD_WORKER_PORT=6334
TOPIC3_RISK_AGENT_PORT=6351
# Reserved dedicated Qwen port. 176+182 reuses 6332; do not start vLLM on 6352.
TOPIC3_RISK_QWEN_PORT=6352
TOPIC1_FRONTEND_PORT=6101
TOPIC1_BACKEND_PORT=6102
TOPIC2_SHOWCASE_PORT=6201
TOPIC2_FILTERGUARD_PORT=6211
TOPIC2_DYNBENCH_PORT=8766

TOPIC3_DIFFICULTY_GENERATION_MODEL_SOURCE=Qwen/Qwen3.5-9B
TOPIC3_DIFFICULTY_GENERATION_MODEL_NAME=Qwen3.5-9B
TOPIC3_DIFFICULTY_GUARD_MODEL_SOURCE=Qwen/Qwen3Guard-Gen-4B
TOPIC3_DIFFICULTY_GUARD_MODEL_NAME=Qwen3Guard-Gen-4B
TOPIC3_DIFFICULTY_GENERATION_GPU=0
TOPIC3_DIFFICULTY_GUARD_GPU=1
# true: 176 starts the local vLLM router and both workers on 6332/6333/6334.
# false: 176 starts only the Topic 3 difficulty agent; 127.0.0.1:6332
# must be provided by an external SSH tunnel or reverse proxy.
TOPIC3_DIFFICULTY_START_LOCAL_INFERENCE=true

TOPIC2_SHOWCASE_ASSET_ROOT=/data/zhangxu/repos/Project_5_LLM_Content_Safety_Governance_Web/web/backend/topic2-showcase-assets
TOPIC2_SHOWCASE_DYNBENCH_BASE_URL=http://127.0.0.1:8766
TOPIC2_SHOWCASE_DYNBENCH_PUBLIC_BASE_URL=http://10.184.17.176:8766

# Topic 1 defaults. Put real keys in deploy.env, never in git.
# Leave empty to let the Topic 1 backend read its own .env.
TOPIC1_LLM_PROVIDER=
TOPIC1_POLICY_CRAWL_ENABLED=false

# Topic 1 value_qa live_run CLI. Put LLM_API_KEY / LLM_API_BASE / LLM_MODEL
# in the Project_1_Sample_evaluation_Generation repo .env, not here.
TOPIC1_VALUE_QA_PROJECT_ROOT=/data/zhangxu/repos/Project_1_Sample_evaluation_Generation
TOPIC1_VALUE_QA_PYTHON=/data/zhangxu/repos/Project_1_Sample_evaluation_Generation/.venv/bin/python

# Project 5 upstreams.
PROJECT5_CORS_ORIGINS='["http://10.184.17.176:5173","http://127.0.0.1:5173","http://localhost:5173"]'
# Topic 3 Benchmark API used by Project 5 backend.
# Local co-deployed Topic 3:
BENCHMARK_BASE_URL=http://127.0.0.1:6006
# Remote Topic 3 example; uncomment when switching Project 5 backend to remote Benchmark.
# BENCHMARK_BASE_URL=https://u288206-6f2x-63496cc3.weste.seetacloud.com:8443
# Remote Qwen inference can take longer than local health checks.
OUTPUT_GUARDRAIL_DETECT_TIMEOUT_SECONDS=300
COMPLIANCE_EDIT_BASE_URL=http://127.0.0.1:6311
COMPLIANCE_EDIT_TIMEOUT_SECONDS=300
# Optional outbound proxy for Project 5 backend. Leave empty to disable.
# Use this when BENCHMARK_BASE_URL points to an online service that the server
# cannot reach directly.
PROJECT5_BACKEND_PROXY_URL=
PROJECT5_BACKEND_NO_PROXY=127.0.0.1,localhost,10.184.17.176,10.184.17.178
TOPIC1_PROJECT1_BASE_URL=http://127.0.0.1:6102
TOPIC4_INPUT_WORKFLOW_BASE_URL=http://127.0.0.1:8081
CULTURAL_GEN_BASE_URL=http://127.0.0.1:6322
CULTURAL_GEN_DATA_BASE_URL=http://127.0.0.1:6323
CULTURAL_ASSESSMENT_ROOT=/data/zhangxu/repos/Project_3_Cultural_Diversity_Assessment_Tool
CULTURAL_ASSESSMENT_CONSOLE_BASE_URL=http://127.0.0.1:8877
CULTURAL_ASSESSMENT_CONSOLE_V2_BASE_URL=http://127.0.0.1:8878
# Optional Topic 3 cultural corpus generator HTTP Job API. Leave empty to use
# Project 5's local demo adapter for small live-generation checks.
CULTURAL_CORPUS_GENERATOR_BASE_URL=
CULTURAL_CORPUS_GENERATOR_ROOT=/data/zhangxu/repos/Project_3_Cultural_Diversity_Corpus_Generation_Tool/framework_v3
# Static corpus browser still defaults to legacy framework/runs unless overridden:
CULTURAL_CORPUS_RUNS_DIR=/data/zhangxu/repos/Project_3_Cultural_Diversity_Corpus_Generation_Tool/framework/runs
TOPIC3_DIFFICULTY_BASE_URL=http://127.0.0.1:6331
TOPIC3_DIFFICULTY_VLLM_API_BASE=http://127.0.0.1:6332/v1
# Topic 3 dynamic risk live_run. 176 starts Risk Agent :6351 via
# llmsafe-topic3-risk-agent. Do not point TOPIC3_RISK_AGENT_URL at the
# difficulty Agent :6331 (different API). Qwen reuses the difficulty router.
# The generation package under TOPIC3_RISK_BENCHMARK_PROJECT_ROOT is a local
# snapshot: deploy-all.sh will not git clone or pull it from GitHub.
TOPIC3_RISK_BENCHMARK_PROJECT_ROOT=/data/zhangxu/repos/Project_3_Dynamic_Risk_Benchmark_Generation
TOPIC3_RISK_BENCHMARK_PYTHON=
TOPIC3_RISK_REUSE_DIFFICULTY_QWEN=true
TOPIC3_RISK_QWEN_MODEL=Qwen3.5-9B
TOPIC3_RISK_AGENT_URL=http://127.0.0.1:6351/chat
TOPIC3_RISK_QWEN_API_BASE=http://127.0.0.1:6332/v1
