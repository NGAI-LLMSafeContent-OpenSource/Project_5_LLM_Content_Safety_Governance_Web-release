# Minimal offline release defaults. Never commit real credentials.
GOVERNANCE_ASSISTANT_PROVIDER=stub
GOVERNANCE_SKILL_RUNTIME_MODE=off
TOPIC1_VALUE_QA_AUTO_ENSURE=false
TOPIC2_RISK_DETECT_METHOD=keyword
TOPIC2_ACTIVATION_PROBE_BASE_URL=http://127.0.0.1:6212
DEEPSEEK_API_KEY=
BENCHMARK_ADMIN_TOKEN=
# Optional: use a database path on a local filesystem.
DATABASE_URL=sqlite+aiosqlite:///./content_governance.db
