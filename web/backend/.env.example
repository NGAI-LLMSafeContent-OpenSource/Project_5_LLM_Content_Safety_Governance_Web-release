# Governance assistant provider: qwen | deepseek | stub
GOVERNANCE_ASSISTANT_PROVIDER=qwen

GOVERNANCE_ASSISTANT_DEEPSEEK_BASE_URL=https://api.deepseek.com
GOVERNANCE_ASSISTANT_DEEPSEEK_MODEL=deepseek-v4-pro

# Skill Runtime gradual rollout (#67 / #84): off | on (default on)
GOVERNANCE_SKILL_RUNTIME_MODE=on
# Wall-clock budget for one turn of skill selection plus planning.
# A provider keepalive must not extend the turn past this deadline.
GOVERNANCE_PLANNER_TURN_BUDGET_SECONDS=70

# Copy this file to web/backend/.env and set the real key locally.
# Never commit a real credential.
DEEPSEEK_API_KEY=

# Benchmark management import (/api/admin/benchmark). Independent admin
# credential; leave empty to keep the admin endpoints disabled (503).
BENCHMARK_ADMIN_TOKEN=
# Recorded as uploaded_by on delivery records; not derived from the token.
BENCHMARK_ADMIN_LABEL=benchmark-admin
BENCHMARK_DELIVERY_STAGING_ROOT=benchmark-delivery-staging
# Unsettled imports untouched this long may be taken over by a same-package retry.
BENCHMARK_DELIVERY_STALE_SECONDS=900
BENCHMARK_DELIVERY_MAX_PACKAGE_BYTES=67108864

# Topic 2 online risk detection.
# Method: activation_probe | keyword
TOPIC2_RISK_DETECT_METHOD=activation_probe
# New Activation Probe (primary). The old independent instance was
# https://uu165979-8749-15195365.westc.seetacloud.com:8443 and is not used.
TOPIC2_ACTIVATION_PROBE_BASE_URL=https://u165979-8749-15195365.westc.seetacloud.com:8443
# Optional HTTP proxy when the AutoDL entry is not directly reachable.
TOPIC2_ACTIVATION_PROBE_PROXY_URL=
TOPIC2_ACTIVATION_PROBE_TIMEOUT_SECONDS=60
TOPIC2_ACTIVATION_PROBE_MAX_BATCH=30
# Per-text cap of the new Activation Probe; over-long text fails the whole batch.
TOPIC2_ACTIVATION_PROBE_MAX_TEXT_CHARS=32768

# Topic 1 corpus tools. Empty endpoints disable probes; never infer local paths.
# These are the addresses reachable FROM the Project 5 backend, not the browser.
TOPIC1_REFINEMENT_BASE_URL=
TOPIC1_REFINEMENT_API_KEY=
TOPIC1_DETOX_BASE_URL=
TOPIC1_DETECTION_BASE_URL=
# Admin-managed aliases; no client-supplied model path or endpoint.
# Example: {"small-model":{"label":"Small model","backend":"hf","model":"/data/models/model","device":"cuda:0"}}
TOPIC1_DETECTION_MODELS={}
TOPIC1_CORPUS_TOOLS_TIMEOUT_SECONDS=5
